-- =============================================================================
-- MANUAL ROLLBACK SCRIPT FOR 20261125000000_super_admin_support_access.sql
-- =============================================================================
-- Safe non-destructive rollback:
--   - Immediately ends any active support sessions
--   - Restores prior current_business_id(), current_user_branch_id(), and RLS policy expressions
--   - Preserves super_admin_support_sessions and super_admin_support_audit_logs tables
--     intact so historical audit records are never destroyed.
-- =============================================================================

UPDATE public.super_admin_support_sessions
SET status = 'revoked', ended_at = now()
WHERE status = 'active';

CREATE OR REPLACE FUNCTION public.current_business_id()
RETURNS UUID
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path = public, auth
AS $$
DECLARE
  v_uid UUID := auth.uid();
  v_biz_id UUID;
  v_email TEXT;
BEGIN
  IF v_uid IS NULL THEN
    RETURN NULL;
  END IF;

  SELECT p.business_id INTO v_biz_id
  FROM public.profiles p
  WHERE p.id = v_uid
  LIMIT 1;

  IF v_biz_id IS NOT NULL THEN
    RETURN v_biz_id;
  END IF;

  SELECT
    u.email,
    CASE
      WHEN (u.raw_user_meta_data->>'business_id') ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
      THEN (u.raw_user_meta_data->>'business_id')::UUID
      ELSE NULL
    END
  INTO v_email, v_biz_id
  FROM auth.users u
  WHERE u.id = v_uid;

  IF v_biz_id IS NOT NULL AND EXISTS (SELECT 1 FROM public.businesses b WHERE b.id = v_biz_id) THEN
    RETURN v_biz_id;
  END IF;

  IF v_email IS NOT NULL THEN
    SELECT b.id INTO v_biz_id
    FROM public.businesses b
    WHERE lower(b.email) = lower(v_email)
    ORDER BY b.created_at ASC
    LIMIT 1;
  END IF;

  RETURN v_biz_id;
END;
$$;

CREATE OR REPLACE FUNCTION public.current_user_branch_id()
RETURNS UUID
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT branch_id FROM public.profiles WHERE id = auth.uid() LIMIT 1;
$$;

DO $$
DECLARE
  rec RECORD;
BEGIN
  FOR rec IN
    SELECT tablename, policyname, cmd
    FROM pg_policies
    WHERE schemaname = 'public'
      AND tablename IN (
        'branch_inventory',
        'categories',
        'customer_payments',
        'customers',
        'expenses',
        'invoice_items',
        'invoices',
        'product_batches',
        'products',
        'purchase_items',
        'purchases',
        'sale_items',
        'sales',
        'stock_movements',
        'stock_transfers',
        'supplier_payments',
        'suppliers'
      )
  LOOP
    IF rec.policyname LIKE 'auth delete %' THEN
      EXECUTE format(
        'ALTER POLICY %I ON public.%I USING (((business_id = public.current_business_id()) AND public.is_admin_or_manager(auth.uid())) OR public.is_super_admin(auth.uid()))',
        rec.policyname, rec.tablename
      );
    ELSIF rec.cmd = 'SELECT' THEN
      EXECUTE format(
        'ALTER POLICY %I ON public.%I USING ((business_id = public.current_business_id()) OR public.is_super_admin(auth.uid()))',
        rec.policyname, rec.tablename
      );
    ELSIF rec.cmd = 'INSERT' THEN
      EXECUTE format(
        'ALTER POLICY %I ON public.%I WITH CHECK ((business_id = public.current_business_id()) OR public.is_super_admin(auth.uid()))',
        rec.policyname, rec.tablename
      );
    ELSE
      EXECUTE format(
        'ALTER POLICY %I ON public.%I USING ((business_id = public.current_business_id()) OR public.is_super_admin(auth.uid())) WITH CHECK ((business_id = public.current_business_id()) OR public.is_super_admin(auth.uid()))',
        rec.policyname, rec.tablename
      );
    END IF;
  END LOOP;
END $$;
